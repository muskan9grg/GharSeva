# Template. Copy to .env and fill in your values from
#   console.firebase.google.com → Project settings → Your apps → Web app → Config
#
# On Netlify these same names go in:
#   Site configuration → Environment variables
#
# These are NOT secrets. Firebase web config is public by design and is
# readable in the browser regardless of how it is delivered. Your data is
# protected by Firestore Security Rules and API key restrictions.

FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID='234'
