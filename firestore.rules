// GharSeva — Firestore Security Rules
//
// Paste this whole file into:
//   console.firebase.google.com -> your project -> Firestore Database -> Rules
// then press Publish.
//
// Nothing here is enforced while the database is in test mode. Test mode also
// EXPIRES on a fixed date, after which it denies everything, so publishing
// these before that date is what keeps the app working.

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isMember(homeId) {
      return request.auth != null
        && request.auth.uid in
           get(/databases/$(database)/documents/homes/$(homeId)).data.memberIds;
    }

    // ── Invite codes ───────────────────────────────────────────────
    // One tiny document per code, holding only a household id. A signed-in
    // user may look up a code they were given, but may not list them all, so
    // codes cannot be harvested. Knowing a code reveals nothing on its own —
    // it only names a household whose contents stay locked below.
    match /invites/{code} {
      allow get: if request.auth != null;
      allow list: if false;

      // Created when a household is made. Restricted to the single homeId
      // field so the document cannot be used to smuggle anything else.
      allow create: if request.auth != null
                    && request.resource.data.keys().hasOnly(['homeId']);

      // Only existing members can repoint or remove a code.
      allow update, delete: if isMember(resource.data.homeId);
    }

    // ── The household document ─────────────────────────────────────
    match /homes/{homeId} {

      // Creating a household. isMember() cannot be used here: it reads the
      // very document being created, which does not exist yet, so the rule
      // would error and deny every creation — you could never make a first
      // household. Instead, require that the creator puts themselves in as
      // owner and member, so nobody can create a household they are locked
      // out of or that names someone else as owner.
      allow create: if request.auth != null
                    && request.resource.data.ownerId == request.auth.uid
                    && request.auth.uid in request.resource.data.memberIds;

      allow read, delete: if isMember(homeId);
      allow update: if isMember(homeId);

      // Joining. A signed-in non-member may add THEMSELVES and nothing else.
      // Every clause matters:
      //   affectedKeys  — only the membership fields may change, so this
      //                   cannot be used to rename the home or alter settings
      //   !(uid in old) — you must not already be a member (no no-op writes)
      //   hasAll(old)   — nobody may be removed
      //   size + 1      — exactly one member is added
      //   uid in new    — and that one member is you, not somebody else
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data)
             .affectedKeys().hasOnly(['memberIds', 'members'])
        && !(request.auth.uid in resource.data.memberIds)
        && request.resource.data.memberIds.hasAll(resource.data.memberIds)
        && request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1
        && request.auth.uid in request.resource.data.memberIds;

      // ── Everything inside a household ────────────────────────────
      // staff, ledger, payments, leaves. Members only, no exceptions.
      match /{document=**} {
        allow read, write: if isMember(homeId);
      }
    }

    // ── Feedback ───────────────────────────────────────────────────
    // App-level, not household-level: the only collection here that is not
    // scoped to a home. Any signed-in user may send a message, and may read
    // and withdraw their OWN messages — but never anyone else's.
    //
    // You read what people send in the Firebase console, which bypasses these
    // rules, so no admin rule is needed yet. When upvoting is added, pinned
    // ideas will need a public read path; the `pinned` field is written as
    // false from the start so that will not require touching old documents.
    match /feedback/{id} {
      allow create: if request.auth != null
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 2000
        && request.resource.data.pinned == false
        && request.resource.data.keys().hasOnly(
             ['type','message','authorId','authorName','lang',
              'createdAt','createdAtMs','pinned']);

      allow read, delete: if request.auth != null
                          && resource.data.authorId == request.auth.uid;

      // Immutable once sent — withdraw and resend instead of editing.
      allow update: if false;
    }

    // ── Per-user profile ───────────────────────────────────────────
    // Yours alone. This is why member names are kept on the household
    // document instead: one member cannot read another's profile here.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
